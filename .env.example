EDGESHIELD_DB_PATH=./data/edgeshield.db
EDGESHIELD_HOST=127.0.0.1
EDGESHIELD_PORT=8000
EDGESHIELD_EXECUTOR=template
EDGESHIELD_EXECUTOR_COMMAND=
EDGESHIELD_EXECUTOR_TIMEOUT=30
EDGESHIELD_EXECUTOR_MODEL_PATH=./models/llama.pte
EDGESHIELD_EXECUTOR_TOKENIZER_PATH=./models/tokenizer.model
EDGESHIELD_ALLOW_REMOTE_DASHBOARD=false

# Optional API token for mutating SCI / Live Monitor / Adaptive endpoints (X-EdgeShield-Token)
EDGESHIELD_API_TOKEN=

# Reversible Containment Ladder (dry-run by default for lab safety; set false to enforce nft/dnsmasq)
EDGESHIELD_CONTAINMENT_DRY_RUN=true
EDGESHIELD_CONTAINMENT_DEFAULT_TTL_S=3600
EDGESHIELD_PROTECTED_HOSTS=

# Opt-in Isolated Link Sandbox (strictly disabled by default for 100% offline compliance)
EDGESHIELD_SANDBOX_ENABLED=false
